set export := true

# Default: show all recipes
default:
    @just --list

# Clean tfvars file
[private]
clean_tfvars variables_file:
    #!/usr/bin/bash
    set -euxo pipefail
    if [ -f "${variables_file}" ]; then
        rm -f "${variables_file}"
    fi

# Initialize terraform
[private]
initialize:
    #!/usr/bin/bash
    if [ ! -d ".terraform" ]; then
        terraform init -backend=false
    fi

# Destroy model if exists
[private]
destroy-model:
    juju destroy-model --no-prompt --destroy-storage nifi-test --force || true

# Add a fresh model
add-model: (destroy-model)
    juju add-model nifi-test

# Validate and create tfvars file
validate_test_tfvars variables_file: (clean_tfvars variables_file)
    #!/usr/bin/bash
    set -euxo pipefail
    
    MODEL_UUID=$(juju show-model nifi-test --format=json | jq -r '."nifi-test"["model-uuid"]')
    if ! juju show-model "${MODEL_UUID}" >/dev/null 2>&1; then
        exit 1
    fi
    
    # Create tfvars file with model_uuid and empty nifi_k8s config
    cat > "${variables_file}" <<EOF
    model_uuid = "${MODEL_UUID}"

    nifi_k8s = {
    config = {}
    }
    EOF

# Terraform fmt
fmt: (initialize)
    terraform fmt -recursive

# Terraform validate
validate: (initialize)
    terraform validate

# Lint
lint:
    tflint

# Generate random sensitive props key and add to tfvars
configure_sensitive_props_key variables_file:
    #!/usr/bin/bash
    set -euxo pipefail
    
    # Generate a random 32-character key
    RANDOM_KEY=$(openssl rand -base64 24)
    
    # Update tfvars file with the secret value
    # Terraform will create the Juju secret and grant it to NiFi after deployment
    sed -i 's/config = {}/config = {\n    "sensitive-props-key" = "'"${RANDOM_KEY}"'"\n  }/' "${variables_file}"

# Run kgoss checks
kgoss-checks:
    #!/usr/bin/bash
    set -euxo pipefail
    
    env GOSS_FILES_PATH="test" \
    GOSS_OPTS="--color" \
    GOSS_WAIT_OPTS="-r 480s -s 2s" \
    GOSS_KUBECTL_OPTS="--namespace=nifi-test" \
    kgoss run -i ubuntu:26.04 -p

# Run nifi pod and attach shell in interactive mode
kgoss-checks-run:
    #!/usr/bin/bash
    set -euxo pipefail
    
    env GOSS_FILES_PATH="test" \
    GOSS_OPTS="--color" \
    GOSS_WAIT_OPTS="-r 480s -s 2s" \
    GOSS_KUBECTL_OPTS="--namespace=nifi-test" \
    kgoss edit -i ubuntu:26.04 -p

# Apply with variables file
apply variables_file: (initialize)
    terraform apply -auto-approve -var-file="${variables_file}"

# Destroy terraform and model with variables file
destroy variables_file:
    #!/usr/bin/bash
    set -euxo pipefail
    if [ -f "${variables_file}" ]; then
        terraform destroy -auto-approve -var-file="${variables_file}" || true
    fi
    just destroy-model
    # Clean up tfvars file
    rm -f "${variables_file}"

# Wait for all applications to be active
wait-for-active:
    #!/usr/bin/env bash
    set -euxo pipefail

    if ! juju wait-for model nifi-test \
        --query='forEach(applications, app => app.status == "active")' \
        --timeout=3600s; then
        echo "Timed out waiting for model to become active"
        exit 1
    fi

# Generic test (create model, apply, wait, kgoss checks, cleanup)
[private]
_test tfvars:
    #!/usr/bin/bash
    set -euxo pipefail

    trap 'just destroy "{{ tfvars }}"' EXIT

    just add-model

    just validate_test_tfvars "{{ tfvars }}"
    
    just configure_sensitive_props_key "{{ tfvars }}"

    just apply "{{ tfvars }}"

    just wait-for-active

    just kgoss-checks

# Full test (default)
test: (_test "test/terraform_test.tfvars")

# Enable git-integrator in the tfvars file
[private]
enable_git_integrator variables_file:
    #!/usr/bin/bash
    set -euxo pipefail
    cat >> "${variables_file}" <<EOF

    git_integrator = {
    enabled = true
    config = {
    repository_url = "https://github.com/canonical/git-integrator.git"
    tracking_ref   = "main"
    }
    }
    EOF

# Generic test with git-integrator enabled
[private]
_test_git_integrator tfvars:
    #!/usr/bin/bash
    set -euxo pipefail

    trap 'just destroy "{{ tfvars }}"' EXIT

    just add-model

    just validate_test_tfvars "{{ tfvars }}"

    just configure_sensitive_props_key "{{ tfvars }}"

    just enable_git_integrator "{{ tfvars }}"

    just apply "{{ tfvars }}"

    just wait-for-active

    just kgoss-checks

# Full test with git-integrator enabled
test-git-integrator: (_test_git_integrator "test/terraform_test_git_integrator.tfvars")
